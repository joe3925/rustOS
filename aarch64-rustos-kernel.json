{
  "arch": "aarch64",
  "llvm-target": "aarch64-pc-windows-msvc",
  "os": "windows",
  "env": "msvc",
  "vendor": "pc",
  "linker": "lld-link",
  "linker-flavor": "msvc",
  "linker-is-gnu": false,
  "lld-flavor": "link",
  "is-like-msvc": true,
  "is-like-windows": true,
  "cpu": "generic",
  "data-layout": "e-m:w-p270:32:32-p271:32:32-p272:64:64-p:64:64-i32:32-i64:64-i128:128-n32:64-S128-Fn32",
  "target-pointer-width": 64,
  "target-endian": "little",
  "target-family": ["windows"],
  "features": "+v8a,+neon",
  "has-thread-local": true,
  "max-atomic-width": 128,
  "dynamic-linking": false,
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "exe-suffix": ".exe",
  "binary-format": "coff",
  "archive-format": "coff",
  "debuginfo-kind": "dwarf",
  "emit-debug-gdb-scripts": false,
  "split-debuginfo": "off",
  "supported-split-debuginfo": ["off"],
  "panic-strategy": "abort",
  "relocation-model": "static",
  "code-model": "large",
  "executables": true,
  "no-default-libraries": true,
  "pre-link-args": {
    "msvc": [
      "/NOLOGO",
      "/NODEFAULTLIB",
      "/SUBSYSTEM:NATIVE",
      "/ENTRY:kernel_pe_entry",
      "/FIXED",
      "/DYNAMICBASE:NO",
      "/BASE:0xFFFF850000000000",
      "/EXPORT:kernel_pe_entry",
      "/DEBUG:SYMTAB"
    ],
    "msvc-lld": [
      "/NOLOGO",
      "/NODEFAULTLIB",
      "/SUBSYSTEM:NATIVE",
      "/ENTRY:kernel_pe_entry",
      "/FIXED",
      "/DYNAMICBASE:NO",
      "/BASE:0xFFFF850000000000",
      "/EXPORT:kernel_pe_entry",
      "/DEBUG:SYMTAB"
    ]
  },
  "requires-uwtable": true,
  "crt-static-respected": true,
  "crt-static-allows-dylibs": false,
  "plt-by-default": false,
  "staticlib-prefix": "",
  "staticlib-suffix": ".lib"
}
