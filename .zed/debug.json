[
  {
    "label": "LLDB Rust Kernel x86_64",
    "adapter": "CodeLLDB",
    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",

    "targetCreateCommands": [
      "target create \"$ZED_WORKTREE_ROOT/target/rustos/x86_64-uefi/debug/kernel/kernel.exe\"",
    ],

    "processCreateCommands": [
      "platform shell cargo run -p xtask -- qemu --platform x86_64-uefi --launch qemu-x86_64-q35-tcg --debug --detach --lldb-meta --file-serial target/rustos/x86_64-uefi/debug/qemu-com1.log",
      "gdb-remote localhost:1234"
    ],

    "postRunCommands": [
      "command source \"$ZED_WORKTREE_ROOT/target/rustos/debug.lldb\""
    ],

    "stopOnEntry": true,
    "sourceLanguages": ["rust"]
  },
  {
    "label": "LLDB Rust Kernel AArch64",
    "adapter": "CodeLLDB",

    "request": "launch",
    "cwd": "$ZED_WORKTREE_ROOT",

    "targetCreateCommands": [
      "settings set plugin.process.gdb-remote.packet-timeout 10000",
      "target create \"$ZED_WORKTREE_ROOT/target/rustos/aarch64-uefi/debug/kernel/kernel.exe\"",
    ],

    "processCreateCommands": [
      "platform shell cargo run -p xtask -- qemu --platform aarch64-uefi --launch qemu-aarch64-virt-hvf --debug --detach --lldb-meta --file-serial target/rustos/aarch64-uefi/debug/qemu-com1.log",
      "gdb-remote localhost:1234"
    ],

    "postRunCommands": [
      "command source \"$ZED_WORKTREE_ROOT/target/rustos/debug.lldb\""
    ],

    "stopOnEntry": true,
    "sourceLanguages": ["rust"]
  },

    {
      "label": "Attach RustOS to existing QEMU",
      "adapter": "CodeLLDB",
      "request": "attach",

      "program": "$ZED_WORKTREE_ROOT/target/rustos/x86_64-uefi/debug/kernel/kernel.exe",

      "initCommands": [
        "settings set plugin.process.gdb-remote.packet-timeout 10000",
      ],

      "processCreateCommands": [
        "gdb-remote 127.0.0.1:1234"
      ],

      "sourceLanguages": [
        "rust"
      ]
    }

]
