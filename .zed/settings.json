{
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "ignore_system_version": true
      },
      "initialization_options": {
        "linkedProjects": [
          "drivers/Cargo.toml",
          "kernel/Cargo.toml",
          "libs/kernel_types/Cargo.toml",
          "third_party/rust-fatfs/Cargo.toml",
          "third_party/aarch64-bootloader/bootloader/Cargo.toml",
          "third_party/aarch64-bootloader/bootloader-api/Cargo.toml",
          "libs/kernel_macros/Cargo.toml",
          "Cargo.toml"
        ],
        "cfg": {
            "setTest": false
        },
        "cargo": {

          "allTargets": false,
          "target": "aarch64-unknown-none",
          "buildScripts": {
            "enable": false
          }
        },

        "procMacro": {
          "enable": true
        },

        "checkOnSave": true,

        "check": {
          "allTargets": false,
          "targets": [
            "x86_64-pc-windows-msvc",
            "aarch64-unknown-none"
          ]
        },

        "diagnostics": {
          "experimental": {
            "enable": false
          }
        }
      }
    }
  }
}
